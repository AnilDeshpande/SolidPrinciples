@startuml
!define KO_KOTLIN
!define KO_ICON
skinparam class {
    BackgroundColor White
    ArrowColor SeaGreen
    BorderColor Black
}

package "com.codetutor.solidprinciples.integrated" {

    class College {
        - staffManager: StaffManager
        - studentManager: StudentManager
        - engagementManager: EngagementManager
        - departments: MutableList<Department>
        - staff: MutableList<Staff>
        - students: MutableList<Student>
        - courses: MutableList<Course>

        + addDepartment(department: Department)
        + addStudent(student: Student)
        + addCourse(course: Course)
        + assignStaffToDepartment(staffMember: Staff, department: Department)
        + engageStudents(staffMember: Staff, subject: String, students: List<Student>)
    }

    abstract class Department {
        + name: String
    }

    class AcademicDepartment extends Department
    class NonAcademicDepartment extends Department

    abstract class Student {
        + name: String
        + age: Int
        + dateOfBirth: String
        + department: Department
        + currentSemester: Int
        + address: Address
    }

    interface CourseTypeProvider {
        + getCourseType(): String
    }

    class UndergraduateStudent extends Student implements CourseTypeProvider {
        + getCourseType(): String
    }

    class PostGraduateStudent extends Student implements CourseTypeProvider {
        + getCourseType(): String
    }

    class PhdStudent extends Student implements CourseTypeProvider {
        + getCourseType(): String
    }

    class PostDocStudent extends Student

    abstract class Staff {
        + name: String
        + department: Department
        + salaryCalculator: SalaryCalculator

        + abstract engageStudents(subject: String, students: List<Student>, strategy: EngagementStrategy)
    }

    interface SalaryReceivingStaff {
        + getSalary(): Double
    }

    class AcademicStaff extends Staff implements SalaryReceivingStaff {
        + salary: Double
        + getSalary(): Double
        + engageStudents(subject: String, students: List<Student>, strategy: EngagementStrategy)
    }

    class NonAcademicStaff extends Staff implements SalaryReceivingStaff {
        + salary: Double
        + getSalary(): Double
        + engageStudents(subject: String, students: List<Student>, strategy: EngagementStrategy)
    }

    class VisitingStaff extends Staff {
        + payPerVisit: Double
        + engageStudents(subject: String, students: List<Student>, strategy: EngagementStrategy)
    }

    abstract class Course {
        + name: String
        + department: Department
    }

    interface TenureProvider {
        + getTenure(): Int?
    }

    class UndergraduateCourse extends Course implements TenureProvider {
        + tenure: Int
        + getTenure(): Int?
    }

    class PostGraduateCourse extends Course implements TenureProvider {
        + tenure: Int
        + getTenure(): Int?
    }

    class PhdCourse extends Course
    class PostDocCourse extends Course

    interface DetailedAddress {
        + getFullAddress(): String
        + getLocalAddress(): String
        + getHomeAddress(): String
        + getPostalCode(): String
    }

    class Address implements DetailedAddress {
        + localAddress: String?
        + homeAddress: String
        + getFullAddress(): String
        + getLocalAddress(): String
        + getHomeAddress(): String
        + getPostalCode(): String
    }
}

package "com.codetutor.solidprinciples.integrated.calculators" {

    interface SalaryCalculator {
        + calculateSalary(staff: Staff): Double
    }

    class AcademicSalaryCalculator implements SalaryCalculator {
        + calculateSalary(staff: Staff): Double
    }

    class VisitingSalaryCalculator implements SalaryCalculator {
        + calculateSalary(staff: Staff): Double
    }

    interface PayslipGenerator {
        + generatePaySlip(staff: Staff): String
    }

    interface BonusApplier {
        + applyBonus(staff: Staff, bonus: Double): Double
    }

    interface TDSCalculator {
        + deductTaxes(staff: Staff, tax: Double): Double
    }
}

package "com.codetutor.solidprinciples.integrated.managers" {

    interface EngagementStrategy {
        + engageStudents(staff: Staff, subject: String, students: List<Student>)
    }

    class StaffManager {
        + assignStaffToDepartment(staff: Staff, department: Department)
    }

    class StudentManager {
        + registerStudent(students: MutableList<Student>, student: Student)
        + engageStudents(staff: Staff, subject: String, students: List<Student>)
    }

    class EngagementManager {
        + engageStudents(staff: Staff, subject: String, students: List<Student>)
    }

    class WorkshopEngagement implements EngagementStrategy {
        + engageStudents(staff: Staff, subject: String, students: List<Student>)
    }

    class LectureEngagement implements EngagementStrategy, MaterialPreperator {
        + engageStudents(staff: Staff, subject: String, students: List<Student>)
        + prepareMaterials(staff: Staff, subject: String)
    }

    interface MaterialPreperator {
        + prepareMaterials(staff: Staff, subject: String)
    }
}

' Student has an address
Student "1" -- "1" Address : lives at >

' Course is offered by a department
Course "1" -- "1" Department : offered by >

' Course has a tenure (only for Undergraduate and PostGraduate)
UndergraduateCourse "1" -- "1" TenureProvider : provides tenure >
PostGraduateCourse "1" -- "1" TenureProvider : provides tenure >

' Address is associated with a Student
Address "1" -- "1" Student : belongs to >

' StaffManager assigns staff to a department
StaffManager "1" -- "*" Staff : manages >
StaffManager "1" -- "*" Department : assigns to >

' StudentManager registers students
StudentManager "1" -- "*" Student : registers >

' StudentManager engages students
StudentManager "1" -- "*" Staff : engages >
StudentManager "1" -- "*" Student : engages >

' EngagementManager manages multiple strategies
EngagementManager "1" -- "*" EngagementStrategy : manages >

' EngagementManager engages students
EngagementManager "1" -- "*" Staff : manages engagements >
EngagementManager "1" -- "*" Student : engages >

' LectureEngagement is a type of EngagementStrategy


' WorkshopEngagement is a type of EngagementStrategy


' LectureEngagement prepares materials
LectureEngagement "1" -- "1" MaterialPreperator : prepares materials >

' SalaryCalculator is implemented by different salary calculators



@enduml